{
  "name": "dtf-orders-runtime",
  "main": "./scripts/orders-runtime-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public/", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "DESIGN_ASSETS", "bucket_name": "dtf-studio-design-assets" }],
  "durable_objects": { "bindings": [{ "name": "ITEMS", "class_name": "ItemStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ItemStore"] }]
}
