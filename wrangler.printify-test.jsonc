{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dtf-studio-printify-import-test",
  "main": "./workers/printify-import-test.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ITEMS", "class_name": "ItemStore" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ItemStore"]
    }
  ]
}
