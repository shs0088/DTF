# DTF Studio Odoo 19 M1 example environment.
# Copy this file to .env locally and replace every CHANGE_ME value.
# Never commit the populated .env file.
COMPOSE_PROJECT_NAME=dtf_studio_odoo19
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
ODOO_ADMIN_PASSWORD=CHANGE_ME_STRONG_ODOO_MASTER_PASSWORD
ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:16
NGINX_IMAGE=nginx:1.27-alpine
TZ=Asia/Amman
