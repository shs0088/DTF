# DTF Studio Odoo 19 M10 production environment template.
# Copy to .env.production on the NEW VPS and replace every CHANGE_ME value.
# Never commit populated secrets.
COMPOSE_PROJECT_NAME=dtf_studio_odoo19_prod
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
ODOO_ADMIN_PASSWORD=CHANGE_ME_STRONG_ODOO_MASTER_PASSWORD
ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:16
NGINX_IMAGE=nginx:1.27-alpine
CERTBOT_IMAGE=certbot/certbot:latest
ODOO_WORKERS=2
TZ=Asia/Amman

# NEW backend/admin origin only. Never use the protected V48 hostname.
DTF_ODOO_DOMAIN=CHANGE_ME_NEW_ODOO_DOMAIN
DTF_TLS_EMAIL=CHANGE_ME_TLS_EMAIL

# Optional: once the new preserved frontend Worker is deployed, monitor it too.
DTF_FRONTEND_URL=
BACKUP_RETENTION_DAYS=14
