<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtf_admin_qualification_reject_wizard" model="ir.ui.view">
        <field name="name">dtf.admin.qualification.reject.wizard.form</field>
        <field name="model">dtf.admin.qualification.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Qualification">
                <group>
                    <field name="profile_id"/>
                    <field name="reason" placeholder="Rejection Reason"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Rejection"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_dtf_admin_design_reject_wizard" model="ir.ui.view">
        <field name="name">dtf.admin.design.reject.wizard.form</field>
        <field name="model">dtf.admin.design.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Design">
                <group>
                    <field name="design_id"/>
                    <field name="reason" placeholder="Rejection Reason"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Rejection"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
