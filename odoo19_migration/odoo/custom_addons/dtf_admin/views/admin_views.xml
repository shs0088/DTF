    <record id="dtf_production.menu_dtf_operations_root" model="ir.ui.menu">
        <field name="parent_id" ref="menu_dtf_admin_root"/>
        <field name="sequence">50</field>
    </record>

    <record id="dtf_finance.menu_dtf_finance_root" model="ir.ui.menu">
        <field name="parent_id" ref="menu_dtf_admin_root"/>
        <field name="sequence">60</field>
    </record>
</odoo>
