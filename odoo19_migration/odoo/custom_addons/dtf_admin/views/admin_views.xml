<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtf_admin_designer_list" model="ir.ui.view">
        <field name="name">dtf.admin.designer.list</field>
        <field name="model">dtf.designer.profile</field>
        <field name="arch" type="xml">
            <list string="Designers" create="0" delete="0" default_order="create_date desc">
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="qualification_state"/>
                <field name="authorized"/>
                <field name="application_date"/>
                <field name="review_deadline"/>
                <field name="rejection_count"/>
            </list>
        </field>
    </record>

    <record id="view_dtf_admin_designer_form" model="ir.ui.view">
        <field name="name">dtf.admin.designer.form</field>
        <field name="model">dtf.designer.profile</field>
        <field name="arch" type="xml">
            <form string="Designer Administration" create="0" delete="0">
                <header>
                    <button name="action_start_admin_review"
                            type="object"
                            string="Start Admin Review"
                            class="btn-primary"
                            invisible="qualification_state not in ('system_qualified', 'under_review')"/>
                    <button name="action_authorize"
                            type="object"
                            string="Authorize"
                            class="btn-primary"
                            invisible="qualification_state == 'authorized'"/>
                    <button name="action_open_qualification_reject_wizard"
                            type="object"
                            string="Reject"
                            groups="dtf_core.group_dtf_admin"
                            invisible="qualification_state not in ('system_qualified', 'under_review')"/>
                    <field name="qualification_state"
                           widget="statusbar"
                           statusbar_visible="draft,system_qualified,under_review,replacement_required,escalated,authorized,rejected"
                           readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Designer">
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="active"/>
                            <field name="authorized" readonly="1"/>
                        </group>
                        <group string="Qualification">
                            <field name="application_date" readonly="1"/>
                            <field name="review_deadline" readonly="1"/>
                            <field name="replacement_deadline" readonly="1"/>
                            <field name="rejection_count" readonly="1"/>
                            <field name="last_rejection_reason" readonly="1"/>
                        </group>
                    </group>
                    <group string="Qualification Designs">
                        <field name="qualification_design_ids" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dtf_admin_design_list" model="ir.ui.view">
        <field name="name">dtf.admin.design.list</field>
        <field name="model">dtf.design</field>
        <field name="arch" type="xml">
            <list string="Designs" create="0" delete="0" default_order="create_date desc">
                <field name="designer_id"/>
                <field name="title_en"/>
                <field name="title_ar"/>
                <field name="product_type"/>
                <field name="state"/>
                <field name="main_display_asset_id"/>
                <field name="ready_to_print_master_asset_id"/>
                <field name="is_qualification_sample"/>
            </list>
        </field>
    </record>

    <record id="view_dtf_admin_design_form" model="ir.ui.view">
        <field name="name">dtf.admin.design.form</field>
        <field name="model">dtf.design</field>
        <field name="arch" type="xml">
            <form string="Design Review" create="0" delete="0">
                <header>
                    <button name="action_publish"
                            type="object"
                            string="Publish"
                            class="btn-primary"
                            invisible="state == 'published' or is_qualification_sample"/>
                    <button name="action_open_admin_reject_wizard"
                            type="object"
                            string="Reject"
                            groups="dtf_core.group_dtf_admin"
                            invisible="state != 'draft'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,published,rejected,archived"
                           readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="designer_id" readonly="1"/>
                        <field name="product_type" readonly="1"/>
                        <field name="is_qualification_sample" readonly="1"/>
                    </group>

                    <group string="Bilingual Content" col="2">
                        <group string="English Content">
                            <div dir="ltr">
                                <label for="title_en"/>
                                <field name="title_en" nolabel="1"/>
                                <label for="description_en"/>
                                <field name="description_en" nolabel="1"/>
                            </div>
                        </group>
                        <group string="Arabic Content">
                            <div dir="rtl">
                                <label for="title_ar"/>
                                <field name="title_ar" nolabel="1"/>
                                <label for="description_ar"/>
                                <field name="description_ar" nolabel="1"/>
                            </div>
                        </group>
                    </group>

                    <group string="Display and Production">
                        <field name="main_display_asset_id" readonly="1"/>
                        <field name="ready_to_print_master_asset_id" readonly="1"/>
                    </group>

                    <group string="Admin Rejection" invisible="not admin_rejection_reason">
                        <field name="admin_rejection_reason" readonly="1"/>
                        <field name="admin_rejected_at" readonly="1"/>
                        <field name="admin_rejected_by_id" readonly="1"/>
                    </group>

                    <group string="Assets">
                        <field name="asset_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="mime_type"/>
                                <field name="pixel_width"/>
                                <field name="pixel_height"/>
                                <field name="embedded_dpi"/>
                                <field name="previewable"/>
                                <field name="readable"/>
                                <field name="analyzable"/>
                                <field name="preflight_state"/>
                                <field name="is_main_display_image"/>
                                <field name="is_ready_to_print_master"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dtf_admin_printify_mapping_list" model="ir.ui.view">
        <field name="name">dtf.admin.printify.mapping.list</field>
        <field name="model">dtf.printify.mapping</field>
        <field name="arch" type="xml">
            <list string="Supplier Catalog Mappings" create="0" edit="0" delete="0">
                <field name="shop_id"/>
                <field name="printify_product_id" string="Supplier Product ID"/>
                <field name="printify_variant_id" string="Supplier Variant ID"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="last_sync_state"/>
                <field name="last_sync_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_dtf_admin_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="domain">[('order_line.dtf_design_id', '!=', False)]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_dtf_admin_designers" model="ir.actions.act_window">
        <field name="name">Designers</field>
        <field name="res_model">dtf.designer.profile</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('view_dtf_admin_designer_list'), 'list'), (ref('view_dtf_admin_designer_form'), 'form')]"/>
    </record>

    <record id="action_dtf_admin_qualification_review" model="ir.actions.act_window">
        <field name="name">Qualification Review</field>
        <field name="res_model">dtf.designer.profile</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qualification_state', 'in', ('system_qualified', 'under_review', 'replacement_required', 'escalated'))]</field>
        <field name="views" eval="[(ref('view_dtf_admin_designer_list'), 'list'), (ref('view_dtf_admin_designer_form'), 'form')]"/>
    </record>

    <record id="action_dtf_admin_designs" model="ir.actions.act_window">
        <field name="name">Designs</field>
        <field name="res_model">dtf.design</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('view_dtf_admin_design_list'), 'list'), (ref('view_dtf_admin_design_form'), 'form')]"/>
    </record>

    <record id="action_dtf_admin_design_review" model="ir.actions.act_window">
        <field name="name">Design Review</field>
        <field name="res_model">dtf.design</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="views" eval="[(ref('view_dtf_admin_design_list'), 'list'), (ref('view_dtf_admin_design_form'), 'form')]"/>
    </record>

    <record id="action_dtf_admin_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_dtf_admin_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('order_line.dtf_design_id', '!=', False)]</field>
    </record>

    <record id="action_dtf_admin_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
    </record>

    <record id="action_dtf_admin_inventory" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_dtf_admin_reports" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('order_line.dtf_design_id', '!=', False)]</field>
    </record>

    <record id="action_dtf_admin_supplier_mappings" model="ir.actions.act_window">
        <field name="name">Supplier Catalog Mappings</field>
        <field name="res_model">dtf.printify.mapping</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(ref('view_dtf_admin_printify_mapping_list'), 'list')]"/>
    </record>

    <record id="action_dtf_admin_settings" model="ir.actions.act_window">
        <field name="name">DTF Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'dtf_finance'}</field>
    </record>

    <menuitem id="menu_dtf_admin_root"
              name="DTF Studio"
              sequence="10"
              groups="dtf_core.group_dtf_admin,dtf_core.group_dtf_printing_operator"/>

    <menuitem id="menu_dtf_admin_dashboard"
              name="Dashboard"
              parent="menu_dtf_admin_root"
              action="action_dtf_admin_dashboard"
              sequence="10"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_designers_root"
              name="Designers"
              parent="menu_dtf_admin_root"
              sequence="20"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_designers"
              name="All Designers"
              parent="menu_dtf_admin_designers_root"
              action="action_dtf_admin_designers"
              sequence="10"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_qualification_review"
              name="Qualification Review"
              parent="menu_dtf_admin_designers_root"
              action="action_dtf_admin_qualification_review"
              sequence="20"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_designs"
              name="Designs"
              parent="menu_dtf_admin_designers_root"
              action="action_dtf_admin_designs"
              sequence="30"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_design_review"
              name="Design Review"
              parent="menu_dtf_admin_designers_root"
              action="action_dtf_admin_design_review"
              sequence="40"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_catalog_root"
              name="Catalog"
              parent="menu_dtf_admin_root"
              sequence="30"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_products"
              name="Products"
              parent="menu_dtf_admin_catalog_root"
              action="action_dtf_admin_products"
              sequence="10"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_supplier_mappings"
              name="Supplier Catalog"
              parent="menu_dtf_admin_catalog_root"
              action="action_dtf_admin_supplier_mappings"
              sequence="20"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_inventory"
              name="Inventory"
              parent="menu_dtf_admin_catalog_root"
              action="action_dtf_admin_inventory"
              sequence="30"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_orders"
              name="Orders"
              parent="menu_dtf_admin_root"
              action="action_dtf_admin_orders"
              sequence="40"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_admin_customers"
              name="Customers"
              parent="menu_dtf_admin_root"
              action="action_dtf_admin_customers"
              sequence="45"
