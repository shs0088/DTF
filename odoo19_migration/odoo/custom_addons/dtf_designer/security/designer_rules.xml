<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_dtf_designer_profile_own" model="ir.rule">
        <field name="name">DTF designer can access own profile</field>
        <field name="model_id" ref="model_dtf_designer_profile"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('dtf_core.group_dtf_designer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_dtf_designer_profile_admin_all" model="ir.rule">
        <field name="name">DTF administrator can access all designer profiles</field>
        <field name="model_id" ref="model_dtf_designer_profile"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('dtf_core.group_dtf_admin'))]"/>
    </record>
</odoo>
