<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtf_finance_policy_list" model="ir.ui.view">
        <field name="name">dtf.finance.policy.list</field>
        <field name="model">dtf.finance.policy</field>
        <field name="arch" type="xml">
            <list string="Finance Policies" delete="0">
                <field name="company_id"/>
                <field name="compensation_mode"/>
                <field name="commission_rate"/>
                <field name="flat_royalty"/>
                <field name="minimum_withdrawal"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <record id="view_dtf_finance_policy_form" model="ir.ui.view">
        <field name="name">dtf.finance.policy.form</field>
        <field name="model">dtf.finance.policy</field>
        <field name="arch" type="xml">
            <form string="DTF Finance Policy" delete="0">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="currency_id" readonly="1"/>
                        <field name="compensation_mode"/>
                        <field name="commission_rate" invisible="compensation_mode != 'percentage'"/>
                        <field name="flat_royalty" invisible="compensation_mode != 'flat'"/>
                        <field name="minimum_withdrawal"/>
                    </group>
                    <p>
                        Policy changes affect future earning snapshots only. Existing earnings remain immutable.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtf_finance_account_list" model="ir.ui.view">
        <field name="name">dtf.designer.finance.account.list</field>
        <field name="model">dtf.designer.finance.account</field>
        <field name="arch" type="xml">
            <list string="Designer Finance Accounts" delete="0">
                <field name="designer_id"/>
                <field name="company_id"/>
                <field name="total_earned"/>
                <field name="ledger_balance"/>
                <field name="committed_withdrawals"/>
                <field name="paid_withdrawals"/>
                <field name="available_withdrawal"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <record id="view_dtf_finance_account_form" model="ir.ui.view">
        <field name="name">dtf.designer.finance.account.form</field>
        <field name="model">dtf.designer.finance.account</field>
        <field name="arch" type="xml">
            <form string="Designer Finance Account" delete="0">
                <sheet>
                    <group>
                        <group string="Designer">
                            <field name="designer_id"/>
                            <field name="company_id"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group string="Balances">
                            <field name="total_earned" readonly="1"/>
                            <field name="ledger_balance" readonly="1"/>
                            <field name="committed_withdrawals" readonly="1"/>
                            <field name="paid_withdrawals" readonly="1"/>
                            <field name="available_withdrawal" readonly="1"/>
                        </group>
                    </group>
                    <group string="Designer-Specific Compensation Override">
                        <field name="override_enabled"/>
                        <field name="override_mode" invisible="not override_enabled"/>
                        <field name="override_commission_rate"
                               invisible="not override_enabled or override_mode != 'percentage'"/>
                        <field name="override_flat_royalty"
                               invisible="not override_enabled or override_mode != 'flat'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtf_designer_earning_list" model="ir.ui.view">
        <field name="name">dtf.designer.earning.list</field>
        <field name="model">dtf.designer.earning</field>
        <field name="arch" type="xml">
            <list string="Designer Earnings" create="0" edit="0" delete="0">
                <field name="designer_id"/>
                <field name="sale_order_id"/>
                <field name="sale_line_id"/>
                <field name="design_id"/>
                <field name="quantity"/>
                <field name="compensation_source"/>
                <field name="compensation_mode"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_dtf_designer_earning_form" model="ir.ui.view">
        <field name="name">dtf.designer.earning.form</field>
        <field name="model">dtf.designer.earning</field>
        <field name="arch" type="xml">
            <form string="Designer Earning Snapshot" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Sale Evidence">
                            <field name="designer_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_line_id"/>
                            <field name="design_id"/>
                            <field name="master_asset_id"/>
                            <field name="preflight_result_id"/>
                            <field name="quantity"/>
                        </group>
                        <group string="Compensation Snapshot">
                            <field name="compensation_source"/>
                            <field name="compensation_mode"/>
                            <field name="commission_rate_snapshot"/>
                            <field name="flat_royalty_snapshot"/>
                            <field name="source_amount"/>
                            <field name="source_currency_id"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Immutable Evidence">
                        <field name="preflight_snapshot" widget="json"/>
                        <field name="payment_snapshot" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtf_withdrawal_list" model="ir.ui.view">
        <field name="name">dtf.designer.withdrawal.list</field>
        <field name="model">dtf.designer.withdrawal</field>
        <field name="arch" type="xml">
            <list string="Designer Withdrawals" create="0" delete="0">
                <field name="designer_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="requested_at"/>
                <field name="approved_at"/>
                <field name="paid_at"/>
            </list>
        </field>
    </record>

    <record id="view_dtf_withdrawal_form" model="ir.ui.view">
        <field name="name">dtf.designer.withdrawal.form</field>
        <field name="model">dtf.designer.withdrawal</field>
        <field name="arch" type="xml">
            <form string="Designer Withdrawal" create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'requested'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="requested,approved,rejected,paid"
                           readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="designer_id" readonly="1"/>
                            <field name="finance_account_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_at" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="paid_at" readonly="1"/>
                            <field name="paid_by_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Payout Details">
                        <field name="payout_details" widget="json" readonly="1"/>
                    </group>
                    <group string="Rejection">
                        <field name="rejection_reason" readonly="state != 'requested'"/>
                        <field name="rejected_at" readonly="1"/>
                        <field name="rejected_by_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtf_finance_ledger_list" model="ir.ui.view">
        <field name="name">dtf.finance.ledger.list</field>
        <field name="model">dtf.finance.ledger</field>
        <field name="arch" type="xml">
            <list string="Finance Ledger" create="0" edit="0" delete="0">
                <field name="designer_id"/>
                <field name="entry_type"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="reference_key"/>
                <field name="earning_id"/>
                <field name="withdrawal_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_dtf_finance_accounts" model="ir.actions.act_window">
        <field name="name">Designer Balances</field>
        <field name="res_model">dtf.designer.finance.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtf_finance_earnings" model="ir.actions.act_window">
        <field name="name">Designer Earnings</field>
        <field name="res_model">dtf.designer.earning</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtf_finance_withdrawals" model="ir.actions.act_window">
        <field name="name">Withdrawals</field>
        <field name="res_model">dtf.designer.withdrawal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtf_finance_ledger" model="ir.actions.act_window">
        <field name="name">Finance Ledger</field>
        <field name="res_model">dtf.finance.ledger</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_dtf_finance_policy" model="ir.actions.act_window">
        <field name="name">Finance Policy</field>
        <field name="res_model">dtf.finance.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dtf_finance_root"
              name="DTF Finance"
              sequence="70"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_finance_accounts"
              name="Designer Balances"
              parent="menu_dtf_finance_root"
              action="action_dtf_finance_accounts"
              sequence="10"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_finance_earnings"
              name="Earnings"
              parent="menu_dtf_finance_root"
              action="action_dtf_finance_earnings"
              sequence="20"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_finance_withdrawals"
              name="Withdrawals"
              parent="menu_dtf_finance_root"
              action="action_dtf_finance_withdrawals"
              sequence="30"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_finance_ledger"
              name="Ledger"
              parent="menu_dtf_finance_root"
              action="action_dtf_finance_ledger"
              sequence="40"
              groups="dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_finance_policy"
              name="Policy"
              parent="menu_dtf_finance_root"
              action="action_dtf_finance_policy"
              sequence="50"
              groups="dtf_core.group_dtf_admin"/>
</odoo>
