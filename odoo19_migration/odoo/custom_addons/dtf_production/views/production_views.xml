<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtf_print_job_list" model="ir.ui.view">
        <field name="name">dtf.production.print.job.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list string="Printing Jobs" create="0" delete="0">
                <field name="name" string="Job"/>
                <field name="dtf_order_name" string="Order"/>
                <field name="dtf_customer_name" string="Customer"/>
                <field name="dtf_customer_phone" string="Phone"/>
                <field name="dtf_product_name" string="Product"/>
                <field name="product_qty" string="Qty"/>
                <field name="dtf_master_name" string="Print Master"/>
                <field name="dtf_operator_stage" string="Status"/>
            </list>
        </field>
    </record>

    <record id="view_dtf_print_job_form" model="ir.ui.view">
        <field name="name">dtf.production.print.job.form</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <form string="DTF Printing Job" create="0" delete="0">
                <header>
                    <button name="action_dtf_start_preparation" type="object" string="Start Preparation"
                            class="btn-primary" invisible="dtf_operator_stage != 'new'"/>
                    <button name="action_dtf_mark_ready" type="object" string="Mark Ready"
                            class="btn-primary" invisible="dtf_operator_stage != 'under_preparation'"/>
                    <button name="action_dtf_mark_completed" type="object" string="Complete"
                            class="btn-primary" invisible="dtf_operator_stage != 'ready'"/>
                    <button name="action_dtf_cancel" type="object" string="Cancel"
                            invisible="dtf_operator_stage in ('completed', 'cancelled')"/>
                    <field name="dtf_operator_stage"
                           widget="statusbar"
                           statusbar_visible="new,under_preparation,ready,completed,cancelled"
                           readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Order">
                            <field name="name" readonly="1"/>
                            <field name="dtf_order_name" readonly="1"/>
                            <field name="dtf_customer_name" readonly="1"/>
                            <field name="dtf_customer_phone" readonly="1"/>
                        </group>
                        <group string="Production">
                            <field name="dtf_product_name" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ready-to-Print Master">
                        <field name="dtf_master_name" readonly="1"/>
                        <field name="dtf_master_filename" readonly="1"/>
                        <field name="dtf_master_file" filename="dtf_master_filename" readonly="1"/>
                    </group>
                    <group string="Protected Evidence" groups="dtf_core.group_dtf_admin">
                        <field name="dtf_sale_line_id" readonly="1"/>
                        <field name="dtf_design_id" readonly="1"/>
                        <field name="dtf_master_asset_id" readonly="1"/>
                        <field name="dtf_preflight_result_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dtf_print_jobs" model="ir.actions.act_window">
        <field name="name">Printing Jobs</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('dtf_is_print_job', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="views" eval="[(ref('view_dtf_print_job_list'), 'list'), (ref('view_dtf_print_job_form'), 'form')]"/>
    </record>

    <menuitem id="menu_dtf_operations_root"
              name="DTF Operations"
              sequence="60"
              groups="dtf_core.group_dtf_printing_operator,dtf_core.group_dtf_admin"/>

    <menuitem id="menu_dtf_print_jobs"
              name="Orders / Printing Jobs"
              parent="menu_dtf_operations_root"
              action="action_dtf_print_jobs"
              sequence="10"
              groups="dtf_core.group_dtf_printing_operator,dtf_core.group_dtf_admin"/>
</odoo>
