<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dtf_studio" model="ir.module.category">
        <field name="name">DTF Studio</field>
        <field name="description">DTF Studio business roles and access control</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_dtf_designer" model="res.groups">
        <field name="name">DTF Designer</field>
        <field name="category_id" ref="dtf_core.module_category_dtf_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_dtf_printing_operator" model="res.groups">
        <field name="name">DTF Printing Operator</field>
        <field name="category_id" ref="dtf_core.module_category_dtf_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dtf_admin" model="res.groups">
        <field name="name">DTF Administrator</field>
        <field name="category_id" ref="dtf_core.module_category_dtf_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
